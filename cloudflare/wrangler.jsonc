{
  "name": "erd-sync",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true, "head_sampling_rate": 0.01 },
  "ratelimits": [
    { "name": "CONNECTION_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "DiagramRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DiagramRoom"] }],
  "vars": { "ALLOWED_ORIGINS": "https://kuy124.github.io" }
}

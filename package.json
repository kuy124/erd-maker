{
  "name": "erd-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Multiplayer ERD maker with Chen notation and crow's-foot tables, peer-to-peer, no server.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -b && tsc -p mcp/tsconfig.json",
    "mcp": "node mcp/start.mjs",
    "mcp:typecheck": "tsc -p mcp/tsconfig.json",
    "mcp:build": "node mcp/build.mjs",
    "mcp:verify": "node mcp/build.mjs --check && node mcp/verify.mjs && node mcp/verify-http.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run test && npm run build && npm run test:e2e",
    "mcp:build:worker": "node mcp/build-worker.mjs",
    "mcp:deploy": "npm run mcp:build:worker && wrangler deploy --config mcp/wrangler.jsonc",
    "mcp:typecheck:worker": "tsc -p mcp/tsconfig.worker.json --noEmit",
    "mcp:verify:worker": "node mcp/verify-worker.mjs"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "y-indexeddb": "^9.0.12",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
